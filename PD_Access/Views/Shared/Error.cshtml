@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

@if (string.IsNullOrEmpty(ViewBag.UserName as string))
{
    <h1 class="text-danger">UnAuthorized User.</h1>
    <h2 class="text-danger">You are not Authorized to access this application. If you think you have received this message in error, please Login here.</h2>
}

@if ((ViewBag.wrongCounty as bool?) == true)
{
    <h1 class="text-danger">UnAuthorized County.</h1>
    <h2 class="text-danger">You are not Authorized to view this county. Please pick the correct county from the drop down.</h2>
}


