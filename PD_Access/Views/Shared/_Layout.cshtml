@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@{
    var isAuthenticated = User.Identity.IsAuthenticated;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] PD Application</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PD_Access.style.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container w-100">


                <a class="navbar-brand d-flex align-items-center" href="/">
                    <img src="~/images/ofbf-logo.svg" alt="Logo" width="45" height="45" class="d-inline-block align-text-top me-2">
                    PD Application
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
@*                     @if (User.Identity.IsAuthenticated)
                    { 
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Login" asp-action="Index">Create Policy</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="ModifyPolicy" asp-action="Index">Modify Policy</a>
                            </li>
                        </ul>
                    } *@


                    <ul class="navbar-nav ms-auto align-items-center flex-row">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown me-3">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Hello, @User.FindFirst("name")?.Value
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="finalSubmit">
                                <li><a class="dropdown-item"  href="/ModifyPolicy/FinalSubmit">Final Submission</a></li>
                                <li><a class="dropdown-item"  href="/Login/SignOutApp">Logout</a></li>
                                </ul>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                @await Component.InvokeAsync("UserCountyDropdown")
                            </li>
                        }
                        else
                        {
                            <a class="nav-link" href="/Login/Login">Login</a>
                        }
                    </ul>
                </div>
            </div>

        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3 w-100" style="padding-top:84px;">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<style>
    .navbar {
        position: fixed;
        display: flex;
        top:0px;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
        width:100%;
        background-color:black;
    }


</style>
