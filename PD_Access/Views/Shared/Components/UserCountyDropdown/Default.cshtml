@model List<PD_Access.ViewComponents.UserCountyDropdownViewComponent.CountyItem>

<form class="d-flex align-items-center mb-0 ms-3">
    <label for="countyDropdown" class="form-label me-2 mb-0" style="color:white;font-weight:bold">County</label>
    <select id="countyDropdown" class="form-select form-select-sm" onchange="handleCountyChange(this)">
          @if (Context.Session.GetString("PublicPolicy") == "true" ){
            <option value="">All</option>
          }

        @foreach (var county in Model)
        {
            if (county.county_Name == (string)ViewData["SelectedCounty"])
            {
                <option value="@county.county_Name" selected>@county.county_Name</option>
            }
            else
            {
                <option value="@county.county_Name">@county.county_Name</option>
            }
        }
    </select>
</form>

<script>
    function handleCountyChange(selectElement) {
        const selectedCounty = selectElement.value;
        window.location.href = `/ModifyPolicy/Index?county=${encodeURIComponent(selectedCounty)}`;
    }
</script>
