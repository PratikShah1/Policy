@using Microsoft.AspNetCore.Http;
@model PD_Access.Models.ModifyPolicyModel.PolicyViewModel

@{
    var sections = ViewBag.Sections as List<PD_Access.Models.ModifyPolicyModel>;
    var groupedSections = sections.GroupBy(s => s.PolicySectionTitle).ToList();
}
<head>
    <title>Modify Policy</title>
    <link href="~/css/style.css" rel="stylesheet" />
    <script src="https://cdn.ckeditor.com/4.16.2/standard/ckeditor.js"></script>
    <style>
        body {

        font-family: Arial, sans-serif;

        }



        .dropdown-container {
        display: flex;
        gap: 12px;
        background-color: #f8f9fa;
        padding: 16px;
        border-radius: 5px;
        }

        .dropdown-container .form-group {
        width: calc(100%/3 - 8px)
        }

        #editPopup .modal-content {
        width: 200vw; /* 80% of the viewport width */
        max-width: 2000px; /* Optional: set a maximum width */
        margin: auto; /* Center the modal content */
        height: 750px;
        overflow-y: auto;
        }

        #editPopup {
        padding: 20px; /* Adjust padding as needed */
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="dropdown-container">
            <div class="form-group">
                <label for="sectionTitleDropdown">Section Title:</label>
                <select class="select-container3 form-select" id="sectionTitleDropdown">
                    <option value="">All</option>
                    @foreach (var item in Model.SectionTitleDropdownData)
                    {
                        <option value="@item.section_number">@item.section_number - @item.SectionTitle</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="sectionGroupDropdown">Section Group:</label>
                <select class="select-container1 form-select" id="sectionGroupDropdown">
                    <option value="">All</option>
                    @foreach (var item in Model.SectionGroupDropdownData)
                    {
                        <option value="@item.Id">@item.SectionGroupName</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="sectionNumberDropdown">Section Number:</label>
                <select class="select-container2 form-select" id="sectionNumberDropdown">
                    <option value="">All</option>
                    @foreach (var item in Model.SectionNumberDropdownData)
                    {
                        <option value="@item.Id">@item.section_number - @item.section_name</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="content" id="test">
        @foreach (var group in groupedSections)
        {
            <h1>@group.Key</h1>
            var subGroups = group.GroupBy(g => g.PolicySectionName).ToList();
            var readOnly = Context.Session.GetString("ReadOnly");
            bool disableLikeButton = false;

            foreach (var subGroup in subGroups)
            {
                if (@subGroup.Key != "Mission" && @subGroup.Key != "Preamble")
                {
                    <h2>@subGroup.Key</h2>
                }

                foreach (var sec in subGroup)
                {
                    if (@subGroup.Key != "Mission" && @subGroup.Key != "Preamble")
                    { 
                    <div class="section-number-header">
                                <h3>@sec.PolicySectionNumberName @sec.PolicySectionNameNumber</h3>
                                @if (Context.Session.GetString("GroupNames") == null || Context.Session.GetString("ReadOnly") == "true")
                                {
                                    //disableModifyButton = true;
                                    <button data-id="@sec.PolicySectionNumberName" class="btn btn-primary"  style="margin-left:auto;padding-top:14px;padding-bottom:14px;visibility:hidden" ) onclick="openEditPopup(@sec.PolicySectionNumberName)">Modify</button>

                                }
                                else
                                {
                                    <button data-id="@sec.PolicySectionNumberName" class="btn btn-primary" style="margin-left:auto;padding-top:14px;padding-bottom:14px") onclick="openEditPopup(@sec.PolicySectionNumberName)">Modify</button>

                                }
                                @if (Context.Session.GetString("ReadOnly") == "true"){
                                    disableLikeButton = Convert.ToBoolean(readOnly);
                                }
                                <button class="like-button" data-id="@sec.PolicySectionNumberName" style="margin-left:10px;" onclick="toggleLike(this)" @(disableLikeButton ? "disabled" : "")><img src="~/images/like-light.png" alt="Like" class="like-icon"></button>
                                @if (Context.Session.GetString("PublicPolicy") == "true" || Context.Session.GetString("ReadOnly") == "true")
                                {
                                    <a href="javascript:void(0);" class="like-count" id="like-count-@sec.PolicySectionNumberName" onclick="event.stopPropagation(); showLikers(@sec.PolicySectionNumberName)">0</a>

                                }
                                else
                                {
                                    <a href="javascript:void(0);" class="like-count"style="visibility:hidden" id="like-count-@sec.PolicySectionNumberName" onclick="event.stopPropagation(); showLikers(@sec.PolicySectionNumberName)">0</a>

                                }

                            </div>
                            }
                            <div>
                                <div class="content-policy-text"> @Html.Raw(@sec.PolicyText)</div>
                            </div>
                    if (@subGroup.Key != "Mission" && @subGroup.Key != "Preamble")
                    {
                        <div class="section-comments-wrapper SelectChangecontent" style="margin-left: 20px; margin-bottom: 20px;" id="comments-wrapper-@sec.PolicySectionNumberName">


                                @{
                                    var commentCount = sec.Comments?.Count ?? 0;
                                    var commentHeaderText = commentCount > 0
                                    ? $"💬 Modifications (click to expand  -- {commentCount} Modifications)"
                                    : "💬 No Modifications";
                                }


                        <div class="section-comments-header" onclick="toggleSectionComments(@sec.PolicySectionNumberName)">
                            @commentHeaderText
                        </div>

                                <div class="section-comments" id="comments-@sec.PolicySectionNumberName" style="display: none; margin-left: 20px;">
                                    @if (sec.Comments != null && sec.Comments.Any())
                                    {
                                        foreach (var comment in sec.Comments)
                                        {
                                            <div style="margin-bottom: 10px;">
                                                <strong>@comment.modify_user_id</strong> - <em>@comment.modify_action</em><br />
                                                <strong>What:</strong> @comment.modify_what<br />
                                                <strong>Why:</strong> @comment.modify_why
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <em>No comments found for this section.</em>
                                    }
                                </div>

                        </div>
                        }
                        }
                    }
                }
            </div>
		
    <div id="editPopup" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeEditPopup()">×</span>
            <div id="editFormContainer"></div>
        </div>
    </div>

